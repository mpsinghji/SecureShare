# Backend Server Port (default: 5000)
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app

# PostgreSQL Database Connection String (e.g. Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Secret key for JWT token signing
JWT_SECRET=your_super_secret_jwt_key_here

# Supabase Storage Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=secureshare-docs

# Google OAuth Client ID (matching the one in Frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
